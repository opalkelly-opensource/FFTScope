# --- FrontPanel app (Software/) ---
Software/node_modules/
Software/dist/
Software/output/
npm-debug.log*

# --- FrontPanel bench app (Software-bench/) ---
Software-bench/node_modules/
Software-bench/dist/
Software-bench/output/

# --- npm auth tokens (never commit; contains a registry token) ---
.npmrc

# --- Vivado build scratch ---
# project.tcl builds out-of-tree (FFTSCOPE_OUT); these are stray artifacts if a
# build is ever run in-place. The per-variant builds (Gateware/FFTScope-12,
# Gateware/FFTScope-14) each drop their own vivado/ scratch next to project.tcl,
# so these globs use **/ to match at any depth under Gateware/.
Gateware/**/vivado/
Gateware/**/.Xil/
Gateware/**/*.log
Gateware/**/*.jou
Gateware/**/dfx_runtime.txt
# Per-variant IP folders hold user-supplied IP cores; only the README is tracked.
Gateware/*/IP/*
!Gateware/*/IP/README.txt
dfx_runtime.txt
*.backup.log
# Stray Vivado artifacts at the repo root (e.g. validate/probe runs launched here)
/.gen/
/.srcs/
/.cache/
/.Xil/
/vivado*.jou
/vivado*.log
/vivado*.backup.jou
/vivado*.str

# --- OS / editor cruft ---
Thumbs.db
.DS_Store

# --- Claude Code harness ---
.claude/
scratchpad/trace_*.csv
