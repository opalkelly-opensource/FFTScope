<?xml version="1.0" encoding="UTF-8"?>
<!-- Port description format (matches docs.opalkelly.com pinout columns):
     CONNECTOR_PIN=<n>  SYZYGY=<name>  SCHEMATIC=<name>  TYPE=<LVDS|SE|BIDIR>  DIR=<P->F|F->P|BIDIR> — <free notes>
-->
<spirit:abstractionDefinition xmlns:xilinx="http://www.xilinx.com"
                              xmlns:spirit="http://www.spiritconsortium.org/XMLSchema/SPIRIT/1685-2009"
                              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <spirit:vendor>opalkelly.com</spirit:vendor>
  <spirit:library>interface</spirit:library>
  <spirit:name>szg_dac_ad911x_rtl</spirit:name>
  <spirit:version>1.0</spirit:version>
  <spirit:busType spirit:vendor="opalkelly.com" spirit:library="interface" spirit:name="szg_dac_ad911x" spirit:version="1.0"/>
  <spirit:ports>

    <spirit:port>
      <spirit:logicalName>db</spirit:logicalName>
      <spirit:description>CONNECTOR_PIN=5-16  SYZYGY=S0-S11  SCHEMATIC=DB0-DB11  TYPE=SE  DIR=F->P — 12-bit parallel data bus to DAC</spirit:description>
      <spirit:wire>
        <spirit:qualifier><spirit:isData>true</spirit:isData></spirit:qualifier>
        <spirit:onMaster><spirit:presence>required</spirit:presence><spirit:width>12</spirit:width><spirit:direction>out</spirit:direction></spirit:onMaster>
        <spirit:onSlave><spirit:presence>required</spirit:presence><spirit:width>12</spirit:width><spirit:direction>in</spirit:direction></spirit:onSlave>
      </spirit:wire>
    </spirit:port>

    <spirit:port>
      <spirit:logicalName>clkin</spirit:logicalName>
      <spirit:description>CONNECTOR_PIN=34  SYZYGY=C2P_CLKp  SCHEMATIC=CLKIN  TYPE=SE  DIR=F->P — DAC sample clock input from FPGA</spirit:description>
      <spirit:wire>
        <spirit:qualifier><spirit:isClock>true</spirit:isClock></spirit:qualifier>
        <spirit:onMaster><spirit:presence>required</spirit:presence><spirit:width>1</spirit:width><spirit:direction>out</spirit:direction></spirit:onMaster>
        <spirit:onSlave><spirit:presence>required</spirit:presence><spirit:width>1</spirit:width><spirit:direction>in</spirit:direction></spirit:onSlave>
      </spirit:wire>
    </spirit:port>

    <spirit:port>
      <spirit:logicalName>dclkio</spirit:logicalName>
      <spirit:description>CONNECTOR_PIN=33  SYZYGY=P2C_CLKp  SCHEMATIC=DCLKIO  TYPE=SE  DIR=P->F — optional data clock echo from DAC (unused by current gateware)</spirit:description>
      <spirit:wire>
        <spirit:qualifier><spirit:isClock>true</spirit:isClock></spirit:qualifier>
        <spirit:onMaster><spirit:presence>optional</spirit:presence><spirit:width>1</spirit:width><spirit:direction>in</spirit:direction></spirit:onMaster>
        <spirit:onSlave><spirit:presence>optional</spirit:presence><spirit:width>1</spirit:width><spirit:direction>out</spirit:direction></spirit:onSlave>
      </spirit:wire>
    </spirit:port>

    <spirit:port>
      <spirit:logicalName>sclk</spirit:logicalName>
      <spirit:description>CONNECTOR_PIN=18  SYZYGY=S13  SCHEMATIC=SCLK/CLKMD  TYPE=SE  DIR=F->P — SPI serial clock / clock-mode select</spirit:description>
      <spirit:wire>
        <spirit:onMaster><spirit:presence>required</spirit:presence><spirit:width>1</spirit:width><spirit:direction>out</spirit:direction></spirit:onMaster>
        <spirit:onSlave><spirit:presence>required</spirit:presence><spirit:width>1</spirit:width><spirit:direction>in</spirit:direction></spirit:onSlave>
      </spirit:wire>
    </spirit:port>

    <spirit:port>
      <spirit:logicalName>cs_b</spirit:logicalName>
      <spirit:description>CONNECTOR_PIN=17  SYZYGY=S12  SCHEMATIC=CS_B/PWRDN  TYPE=SE  DIR=F->P — SPI chip select / power-down, active low</spirit:description>
      <spirit:wire>
        <spirit:onMaster><spirit:presence>required</spirit:presence><spirit:width>1</spirit:width><spirit:direction>out</spirit:direction></spirit:onMaster>
        <spirit:onSlave><spirit:presence>required</spirit:presence><spirit:width>1</spirit:width><spirit:direction>in</spirit:direction></spirit:onSlave>
      </spirit:wire>
    </spirit:port>

    <spirit:port>
      <spirit:logicalName>sdio_i</spirit:logicalName>
      <spirit:description>CONNECTOR_PIN=19  SYZYGY=S14  SCHEMATIC=SDIO/FORMAT  TYPE=BIDIR  DIR=P->F — input leg of tristate IOBUF triple (wrapper collapses sdio_i/o/t into one bidir pad)</spirit:description>
      <spirit:wire>
        <spirit:qualifier><spirit:isData>true</spirit:isData></spirit:qualifier>
        <spirit:onMaster><spirit:presence>required</spirit:presence><spirit:width>1</spirit:width><spirit:direction>in</spirit:direction></spirit:onMaster>
        <spirit:onSlave><spirit:presence>required</spirit:presence><spirit:width>1</spirit:width><spirit:direction>out</spirit:direction></spirit:onSlave>
      </spirit:wire>
    </spirit:port>

    <spirit:port>
      <spirit:logicalName>sdio_o</spirit:logicalName>
      <spirit:description>CONNECTOR_PIN=19  SYZYGY=S14  SCHEMATIC=SDIO/FORMAT  TYPE=BIDIR  DIR=F->P — output leg of tristate IOBUF triple</spirit:description>
      <spirit:wire>
        <spirit:qualifier><spirit:isData>true</spirit:isData></spirit:qualifier>
        <spirit:onMaster><spirit:presence>required</spirit:presence><spirit:width>1</spirit:width><spirit:direction>out</spirit:direction></spirit:onMaster>
        <spirit:onSlave><spirit:presence>required</spirit:presence><spirit:width>1</spirit:width><spirit:direction>in</spirit:direction></spirit:onSlave>
      </spirit:wire>
    </spirit:port>

    <spirit:port>
      <spirit:logicalName>sdio_t</spirit:logicalName>
      <spirit:description>CONNECTOR_PIN=19  SYZYGY=S14  SCHEMATIC=SDIO/FORMAT  TYPE=BIDIR  DIR=F->P — tristate-enable leg of IOBUF triple (0 = drive, 1 = high-Z)</spirit:description>
      <spirit:wire>
        <spirit:onMaster><spirit:presence>required</spirit:presence><spirit:width>1</spirit:width><spirit:direction>out</spirit:direction></spirit:onMaster>
        <spirit:onSlave><spirit:presence>required</spirit:presence><spirit:width>1</spirit:width><spirit:direction>in</spirit:direction></spirit:onSlave>
      </spirit:wire>
    </spirit:port>

    <spirit:port>
      <spirit:logicalName>opamp_enable</spirit:logicalName>
      <spirit:description>CONNECTOR_PIN=20  SYZYGY=S15  SCHEMATIC=OPAMP_ENABLE  TYPE=SE  DIR=F->P — 1 enables DAC output op-amps, 0 powers them down (unused by current gateware)</spirit:description>
      <spirit:wire>
        <spirit:onMaster><spirit:presence>optional</spirit:presence><spirit:width>1</spirit:width><spirit:direction>out</spirit:direction></spirit:onMaster>
        <spirit:onSlave><spirit:presence>optional</spirit:presence><spirit:width>1</spirit:width><spirit:direction>in</spirit:direction></spirit:onSlave>
      </spirit:wire>
    </spirit:port>

    <spirit:port>
      <spirit:logicalName>reset_pinmd</spirit:logicalName>
      <spirit:description>CONNECTOR_PIN=21  SYZYGY=S16  SCHEMATIC=RESET/PINMD  TYPE=SE  DIR=F->P — reset + pin-mode control</spirit:description>
      <spirit:wire>
        <spirit:onMaster><spirit:presence>required</spirit:presence><spirit:width>1</spirit:width><spirit:direction>out</spirit:direction></spirit:onMaster>
        <spirit:onSlave><spirit:presence>required</spirit:presence><spirit:width>1</spirit:width><spirit:direction>in</spirit:direction></spirit:onSlave>
      </spirit:wire>
    </spirit:port>

  </spirit:ports>
</spirit:abstractionDefinition>
