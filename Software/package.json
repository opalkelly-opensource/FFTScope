{
  "name": "fftscopev2-app",
  "version": "2.0.0",
  "private": true,
  "description": "FFTScope native-AXI instrument application (signal generator, oscilloscope, spectrum analyzer)",
  "author": "Wesley Vong",
  "license": "SEE LICENSE IN LICENSE",
  "main": "index.js",
  "scripts": {
    "pack:dev": "webpack --config webpack.dev.js && node ./scripts/package-fpapp.js ./dist ./output/app-dev.fpp",
    "pack": "webpack --config webpack.prod.js && node ./scripts/package-fpapp.js ./dist ./output/app.fpp",
    "build:dev": "webpack --config webpack.dev.js",
    "build": "webpack --config webpack.prod.js",
    "start": "webpack serve --open --config webpack.dev.js",
    "format-check": "prettier --check ./src/**",
    "lint": "eslint ./src/**/*.{ts,tsx}",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "archiver": "^7.0.1",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "html-webpack-plugin": "^5.6.3",
    "prettier": "^3.2.5",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0",
    "webpack-merge": "^6.0.1"
  },
