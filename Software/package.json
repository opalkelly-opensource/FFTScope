    "@radix-ui/react-toggle": "^1.1.10",
    "chart.js": "^4.4.0",
    "classnames": "^2.3.2",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "sub-events": "^1.9.0"
